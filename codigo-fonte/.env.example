# Copy to .env and fill in with the values from Supabase → Project Settings → API.
# The anon (publishable) key is safe in the app because every table uses row level security.
# Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
