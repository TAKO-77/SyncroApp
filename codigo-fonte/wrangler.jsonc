// Cloudflare Workers static site for the web/PWA build (the Windows app does not use it).
// Workers Builds runs `npm run build` in codigo-fonte/ and then `npx wrangler deploy`.
{
  "name": "app",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
